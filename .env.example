# DataClaw 环境变量示例（复制为 .env 或直接 export）
# 数据目录（默认仓库下 data/）
# DATACLAW_DATA_DIR=C:\dataclaw\data
# 数据库（默认 sqlite，可切 PostgreSQL）
# DATACLAW_DB_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/dataclaw
# JWT 签名密钥（生产必须改）
DATACLAW_SECRET_KEY=change-me-to-a-64-char-random-string-0123456789abcdef

# ---------- LLM（OpenAI 兼容；不配置则使用内置离线确定性 Planner） ----------
# OPENAI_API_KEY=sk-xxxx
# DATACLAW_LLM_BASE_URL=https://api.openai.com/v1
# DATACLAW_LLM_MODEL=gpt-4o-mini
# DATACLAW_LLM_TIMEOUT=120

# 运行时约束
# DATACLAW_MAX_STEPS=12
# DATACLAW_TOOL_TIMEOUT=60
